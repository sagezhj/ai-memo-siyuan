{
  "manifest_version": 3,
  "default_locale": "zh_CN",
  "name": "__MSG_extName__",
  "short_name": "AI Memo SiYuan",
  "version": "0.1.0",
  "description": "__MSG_extDescription__",

  "background": {
    "service_worker": "src/background/index.js"
  },

  "action": {
    "default_title": "AI Memo → SiYuan（点击打开设置）",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "options_ui": {
    "page": "src/pages/settings.html",
    "open_in_tab": true
  },

  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "permissions": ["storage", "alarms", "tabs"],

  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],

  "host_permissions": [
    "*://chat.deepseek.com/*",
    "*://www.qianwen.com/*",
    "*://qianwen.com/*",
    "*://tongyi.com/*",
    "*://www.tongyi.com/*",
    "*://tongyi.ai/*",
    "*://www.tongyi.ai/*",
    "*://chat.qwen.ai/*",
    "*://yuanbao.tencent.com/*",
    "http://127.0.0.1/*",
    "http://localhost/*",
    "http://[::1]/*"
  ],

  "content_scripts": [
    {
      "matches": [
        "*://chat.deepseek.com/*",
        "*://www.qianwen.com/*",
        "*://qianwen.com/*",
        "*://tongyi.com/*",
        "*://www.tongyi.com/*",
        "*://tongyi.ai/*",
        "*://www.tongyi.ai/*",
        "*://chat.qwen.ai/*",
        "*://yuanbao.tencent.com/*"
      ],
      "js": [
        "src/shared/constants.js",
        "src/shared/util.js",
        "src/shared/hash.js",
        "src/shared/dom.js",
        "src/shared/markdown.js",
        "src/shared/rpc.js",
        "src/content/adapters/registry.js",
        "src/content/adapters/deepseek.js",
        "src/content/adapters/qwen.js",
        "src/content/adapters/yuanbao.js",
        "src/content/adapters/generic.js",
        "src/content/diagnose.js",
        "src/content/bubble.js",
        "src/content/observer.js",
        "src/content/main.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],

  "web_accessible_resources": [
    {
      "resources": ["src/pages/selftest.html"],
      "matches": ["<all_urls>"]
    }
  ],

  "minimum_chrome_version": "114"
}
